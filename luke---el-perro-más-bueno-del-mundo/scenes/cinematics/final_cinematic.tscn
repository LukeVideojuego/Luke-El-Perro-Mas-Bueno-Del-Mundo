theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 24
text = "EL HÉROE MUNDIAL"
text += "\nLuke había conseguido algo que parecía imposible."
text += "\nEl mundo entero había recuperado"
text += "\nla esperanza."
text += "\nHabía más amor."
text += "\nMás solidaridad."
text += "\nMás alegría."
text += "\nLuke había conseguido que el mundo"
text += "\nvolviera a ser un lugar mejor."
text += "\n\nLUKE"
text += "\nEL PERRO MÁS BUENO"
text += "\nDEL MUNDO"
text += "\nGRACIAS POR JUGAR"
