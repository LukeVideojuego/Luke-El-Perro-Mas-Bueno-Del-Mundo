text = "EL MUNDO CAMBIÓ"
text += "\nEl mundo que antes estaba triste"
text += "\nahora aparece lleno de luz."
text += "\nCiudades, barrios, plazas y personas felices."

[node name="Panel2" type="Control" parent="."]
