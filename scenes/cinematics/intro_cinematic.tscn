theme_override_constants/outline_size = 6
theme_override_font_sizes/normal_font_size = 26
bbcode_enabled = true
text = "[center]En ese mundo triste vivía Diego, su mejor amigo, un chico con un corazón enorme... aunque también un poco cansado.

Junto a él, los niños que tanto quería —Lara, Bauti, Zoe, Roma y Mathi— ya no jugaban como antes. Habían dejado de soñar.

Sus sonrisas se habían escondido en algún lugar, y nadie sabía cómo encontrarlas de nuevo.[/center]"
fit_content = true
scroll_active = false
horizontal_alignment = 1

