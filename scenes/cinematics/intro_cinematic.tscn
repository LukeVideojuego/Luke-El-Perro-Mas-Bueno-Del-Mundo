[node name="Panel1Text" type="RichTextLabel" parent="Panel1" unique_id=697865172]
custom_minimum_size = Vector2(1666.667, 316.667)
layout_mode = 0
offset_left = 126.667
offset_top = 66.667
offset_right = 126.667
offset_bottom = 66.667
theme_override_colors/default_color = Color(1, 1, 1, 1)
