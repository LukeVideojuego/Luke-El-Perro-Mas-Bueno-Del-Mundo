theme_override_constants/outline_size = 6
theme_override_font_sizes/normal_font_size = 26
bbcode_enabled = true
text = "[center]Hubo un tiempo en que las calles brillaban y las risas se escuchaban en cada esquina.

Pero, poco a poco, el mundo fue perdiendo la alegría. El egoísmo, la indiferencia y la tristeza se instalaron en cada casa, en cada plaza, en cada corazón.

Las luces de la ciudad se apagaron una por una... y con ellas, también se apagó la esperanza.[/center]"
fit_content = true
scroll_active = false
horizontal_alignment = 1

