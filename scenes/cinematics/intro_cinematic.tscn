[node name="Panel3Text" type="RichTextLabel" parent="Panel3" unique_id=1117633452]
custom_minimum_size = Vector2(1666.667, 283.333)
layout_mode = 0
offset_left = 126.667
offset_top = 33.333
offset_right = 126.667
offset_bottom = 33.333
theme_override_colors/default_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/normal_font_size = 24
bbcode_enabled = true
text = "[center]Pero había alguien que todavía creía que las cosas podían cambiar: Luke, el perro más bueno del mundo.

Con su corazón puro y su valentía sin límites, Luke decidió que no se quedaría quieto viendo cómo el mundo se apagaba.

Iba a recorrer cada rincón, ayudar a cada persona, y devolverle la sonrisa a Diego y a sus amigos... ¡y a todo el mundo!

[color=#ffd93d]La aventura de Luke está por comenzar... y vos sos parte de ella![/color][/center]"
fit_content = true
scroll_active = false
horizontal_alignment = 1

